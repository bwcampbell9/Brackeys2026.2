theme_override_font_sizes/font_size = 16
text = "Your customers request recipes. Check the recipe book, collect the ingredients, and prepare each order before they lose patience.\n\nMove with WASD or the arrow keys.\nPress E to interact, pick up items, and use workstations. Hold E when an action takes time.\nPress F to use your held item's secondary action.\n\nHold Q to configure a workstation. Press E to request a worker for a workstation.\n\nCareful! Workers can't always be trusted to grab the right items. Make sure the baby Prince stays safe!!"
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1

