{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot C#: Build",
      "type": "process",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_ROOT": "${env:USERPROFILE}\\.dotnet",
          "PATH": "${env:USERPROFILE}\\.dotnet;${env:PATH}"
        }
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
