{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Validate project",
      "type": "process",
      "command": "${env:GODOT_EXE}",
      "args": [
        "--headless",
        "--editor",
        "--quit",
        "--path",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
